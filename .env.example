# الميرفاوية - required
TELEGRAM_BOT_TOKEN=

# Groq: use one key or several. Never commit real keys.
GROQ_API_KEY=
GROQ_API_KEYS=
GROQ_TEXT_MODEL=openai/gpt-oss-120b

# Optional authorized Telegram user IDs for the private Groq manager.
# Leave empty rather than using a hard-coded account ID.
GROQ_ADMIN_IDS=

# Production persistence. Render PostgreSQL should be used for durable state.
DATABASE_URL=

# Render webhook
PUBLIC_BASE_URL=
WEBHOOK_SECRET=

# Behavior / safety
REPLY_CHANCE=0.80
AI_MIN_SCORE=34
MIN_COOLDOWN_SECONDS=20
MAX_COOLDOWN_SECONDS=45
SOFT_HOURLY_LIMIT=20
HARD_HOURLY_LIMIT=30
MAX_CONSECUTIVE_BOT_MESSAGES=2
PROACTIVE_CHANCE=0.35
PROACTIVE_MIN_INTERVAL=7200
PROACTIVE_MAX_INTERVAL=18000
PROACTIVE_QUIET_SECONDS=600

# Render free-tier warm-up. Paid Render instances should leave this enabled
# only if you specifically want an application-level heartbeat.
KEEPALIVE_ENABLED=true
KEEPALIVE_INTERVAL_SECONDS=480

# Memory
CHAT_MEMORY_SIZE=24
CHAT_MEMORY_TTL_SECONDS=7200
IMAGE_POOL_TTL_SECONDS=21600

# Feature switches
ENABLED_CHAOS=true
ENABLED_MODERATION=true
ENABLED_GAMES=true
ENABLED_PROACTIVE=true

LOG_LEVEL=INFO
