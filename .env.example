# الميرفاوية - required
TELEGRAM_BOT_TOKEN=

# Groq: use one key or several. Never commit real keys.
GROQ_API_KEY=
GROQ_API_KEYS=
GROQ_TEXT_MODEL=openai/gpt-oss-120b
GROQ_ADMIN_IDS=

# Production persistence
DATABASE_URL=
PUBLIC_BASE_URL=
WEBHOOK_SECRET=

# Normal reply behavior
REPLY_CHANCE=0.80
AI_MIN_SCORE=34
MIN_COOLDOWN_SECONDS=20
MAX_COOLDOWN_SECONDS=45
SOFT_HOURLY_LIMIT=20
HARD_HOURLY_LIMIT=30
MAX_CONSECUTIVE_BOT_MESSAGES=2

# Smart proactive: whichever comes first (time OR human-message target),
# but only after the chat has been quiet for PROACTIVE_IDLE_SECONDS.
PROACTIVE_CHANCE=0.35
PROACTIVE_MIN_INTERVAL=7200
PROACTIVE_MAX_INTERVAL=18000
PROACTIVE_MIN_MESSAGES=12
PROACTIVE_MAX_MESSAGES=28
PROACTIVE_IDLE_SECONDS=600

# Night rest window (Morocco local time). No proactive sends during this window.
PROACTIVE_QUIET_START=0
PROACTIVE_QUIET_END=6

# Tiny maintenance rest window cadence for proactive sending.
PROACTIVE_REST_MINUTES=12
PROACTIVE_REST_EVERY_HOURS=6

PROACTIVE_QUIET_SECONDS=600
KEEPALIVE_ENABLED=true
KEEPALIVE_INTERVAL_SECONDS=480

CHAT_MEMORY_SIZE=24
CHAT_MEMORY_TTL_SECONDS=7200
IMAGE_POOL_TTL_SECONDS=21600

ENABLED_CHAOS=true
ENABLED_MODERATION=true
ENABLED_GAMES=true
ENABLED_PROACTIVE=true
LOG_LEVEL=INFO
